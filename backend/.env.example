# Environment Variables for NutriWise360

# Server Configuration
PORT=3000
NODE_ENV=development

# MongoDB Configuration
# For local development, use: mongodb://localhost:27017/nutriwise360
# For production, use MongoDB Atlas connection string
MONGODB_URI=mongodb://localhost:27017/nutriwise360

# Session Configuration
# Generate a random 32+ character string for production
SESSION_SECRET=your-super-secret-key-change-this-in-production

# Session Duration (in milliseconds)
SESSION_MAX_AGE=2592000000
