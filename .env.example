# NutriWise360 Environment Variables
# Copy this file to .env and fill in your actual values

# Server Configuration
PORT=3000
NODE_ENV=development

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/nutriwise360
# For MongoDB Atlas (Production):
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/nutriwise360?retryWrites=true&w=majority

# Session Configuration
SESSION_SECRET=your-super-secret-session-key-change-this-in-production
SESSION_MAX_AGE=86400000

# CORS Configuration (Optional)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# API Keys (Optional - for future features)
# OPENAI_API_KEY=your-openai-api-key
# NUTRITIONIX_APP_ID=your-nutritionix-app-id
# NUTRITIONIX_API_KEY=your-nutritionix-api-key
# SENDGRID_API_KEY=your-sendgrid-api-key

# Frontend URL
FRONTEND_URL=http://localhost:3000

# Security
BCRYPT_ROUNDS=10
